/*
 * Linker script for the bootloader image only.
 *
 * This defines the MEMORY regions the bootloader must be confined to.
 * Splice this MEMORY block into your normal STM32F407 startup /
 * linker script (e.g. the one generated by STM32CubeMX/CubeIDE),
 * replacing its FLASH region - everything else (.isr_vector, .text,
 * .data, .bss, heap/stack sections, startup_stm32f407xx.s) stays the
 * standard CubeIDE/CMSIS boilerplate.
 */

ENTRY(Reset_Handler)

MEMORY
{
  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 32K   /* Bootloader: sectors 0-1 */
  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 128K
}

_estack = ORIGIN(RAM) + LENGTH(RAM);

SECTIONS
{
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))
    . = ALIGN(4);
  } > FLASH

  .text :
  {
    . = ALIGN(4);
    *(.text*)
    *(.rodata*)
    . = ALIGN(4);
    _etext = .;
  } > FLASH

  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data*)
    . = ALIGN(4);
    _edata = .;
  } > RAM AT > FLASH

  .bss :
  {
    . = ALIGN(4);
    _sbss = .;
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
  } > RAM

  ._user_heap_stack :
  {
    . = ALIGN(8);
    . = . + 0x400; /* minimum heap+stack headroom, tune as needed */
    . = ALIGN(8);
  } > RAM
}
